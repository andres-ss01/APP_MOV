<?xml version="1.0" encoding="utf-8"?>
<!--
    Formulario compartido por US06 (crear) y US07 (editar).
    Cada campo vive dentro de un TextInputLayout: al asignarle .error desde el código,
    el contorno y el mensaje se resaltan en ROJO (criterio de aceptación de US06 - Esc. 2).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado: cambia según sea crear o editar -->
        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Agregar producto" />

        <!-- Título -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTitle"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/form_hint_title"
            android:textColorHint="#000000"
            app:boxStrokeColor="@color/primary_green"
            app:boxStrokeErrorColor="@color/error"
            app:errorTextColor="@color/error"
            app:hintTextColor="#000000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:textColor="#000000" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Precio (teclado numérico decimal) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPrice"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/form_hint_price"
            android:textColorHint="#000000"
            app:boxStrokeColor="@color/primary_green"
            app:boxStrokeErrorColor="@color/error"
            app:errorTextColor="@color/error"
            app:hintTextColor="#000000"
            app:prefixText="$">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#000000" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Descripción (multilínea) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescription"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/form_hint_description"
            android:textColorHint="#000000"
            app:boxStrokeColor="@color/primary_green"
            app:boxStrokeErrorColor="@color/error"
            app:errorTextColor="@color/error"
            app:hintTextColor="#000000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:textColor="#000000" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- URL de la imagen -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilImage"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/form_hint_image"
            android:textColorHint="#000000"
            app:boxStrokeColor="@color/primary_green"
            app:boxStrokeErrorColor="@color/error"
            app:errorTextColor="@color/error"
            app:hintTextColor="#000000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="#000000" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Categoría (menú desplegable no editable) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCategory"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/form_hint_category"
            android:textColorHint="#000000"
            app:boxStrokeColor="@color/primary_green"
            app:boxStrokeErrorColor="@color/error"
            app:errorTextColor="@color/error"
            app:hintTextColor="#000000">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="#000000" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Indicador de carga mientras la petición HTTP está en curso -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressSaving"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="@color/primary_green" />

        <!-- Botón Guardar (se deshabilita durante la petición) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/primary_green"
            android:text="@string/form_save"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/form_cancel"
            android:textAllCaps="false"
            android:textColor="@color/primary_green"
            android:textSize="16sp"
            app:strokeColor="@color/primary_green" />

    </LinearLayout>
</ScrollView>