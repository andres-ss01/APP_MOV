<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/catalogFragment">

    <fragment
        android:id="@+id/catalogFragment"
        android:name="com.example.fakestoreapp.ui.catalog.CatalogFragment"
        android:label="@string/catalog_title"
        tools:layout="@layout/fragment_catalog">

        <action
            android:id="@+id/action_catalog_to_detail"
            app:destination="@id/productDetailFragment" />

        <!-- US06: FAB -> formulario en modo "crear" -->
        <action
            android:id="@+id/action_catalog_to_form"
            app:destination="@id/productFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.example.fakestoreapp.ui.detail.ProductDetailFragment"
        android:label=""
        tools:layout="@layout/fragment_product_detail">

        <argument
            android:name="productId"
            app:argType="integer" />

        <!-- US07: botón Editar -> formulario en modo "editar" (con el producto actual) -->
        <action
            android:id="@+id/action_detail_to_form"
            app:destination="@id/productFormFragment" />
    </fragment>

    <!--
        US06 / US07: formulario compartido.
        productJson == null  -> crear producto
        productJson != null  -> editar el producto serializado en JSON (campos precargados)
    -->
    <fragment
        android:id="@+id/productFormFragment"
        android:name="com.example.fakestoreapp.ui.form.ProductFormFragment"
        android:label=""
        tools:layout="@layout/fragment_product_form">

        <argument
            android:name="productJson"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

</navigation>
